---
const { workDetail, index } = Astro.props;
const { title, desc, role, thumbnail, link, video } = workDetail;
const isEven = index % 2 === 0;
---

<article class="w-full overflow-hidden relative group pb-10" data-animate>
  <div
    class={`flex flex-col items-center justify-between space-x-5 
    ${isEven ? "md:flex-row" : "md:flex-row-reverse"}`}
  >
  <div class="w-full md:w-1/2" data-animate={isEven ? 'fade-right' : 'fade-left'}>
      {
        video ? (
          <div class="relative" data-video-card>
            {/* #t=1 makes browsers seek and paint a frame at 1s, so the card shows the video instead of a blank box when no poster exists */}
            <video
              src={`${video}#t=1`}
              poster={thumbnail || undefined}
              class="rounded-lg w-full"
              playsinline
              preload="metadata"
            ></video>
            <button
              type="button"
              class="group/play absolute inset-0 flex items-center justify-center rounded-lg bg-dark/30 transition-colors hover:bg-dark/40"
              aria-label={`Play ${title} demo video`}
              data-video-play
            >
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-blue text-dark shadow-lg transition-transform group-hover/play:scale-110">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="ml-1 h-8 w-8"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </button>
          </div>
        ) : thumbnail ? (
          <img src={thumbnail} alt="projectImage" class="rounded-lg" />
        ) : (
          <div class="aspect-video w-full rounded-lg bg-dark/5 dark:bg-light/5"></div>
        )
      }
    </div>

  <div class="flex flex-col w-full md:w-1/2" data-animate="fade-up" data-animate-delay="80">
      <h2 class="dark:text-white font-semibold text-4xl">{title}</h2>
      <p class="pt-3 text-blue">Role : {role}</p>
      <p class="dark:text-white pt-5">
        {desc}
      </p>
      <div
        class={`mt-8 flex items-center flex-row  ${
          isEven ? "justify-center" : "justify-center"
        }`}
      >
        {
          !link ? (
            <p class="text-blue">Restricted access internal tool</p>
          ) : (
            <a
              href={link}
              class="group cursor-pointer w-40 relative inline-block text-md font-semibold text-white focus:outline-none focus:ring"
              target="_blank"
            >
              <span class="absolute inset-0 border border-blue group-active:border-blue" />
              <span class="block border border-blue py-2 flex justify-center bg-blue items-center transition-transform active:border-blue active:bg-blue group-hover:-translate-x-1 group-hover:-translate-y-1">
                Visit Project
              </span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>("[data-video-card]").forEach((card) => {
    const video = card.querySelector("video");
    const playButton = card.querySelector<HTMLButtonElement>("[data-video-play]");
    if (!video || !playButton) return;

    playButton.addEventListener("click", () => {
      video.controls = true;
      playButton.classList.add("hidden");
      video.currentTime = 0;
      video.play().catch(() => {});
    });

    video.addEventListener("ended", () => {
      playButton.classList.remove("hidden");
    });
  });
</script>
